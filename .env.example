OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...

# Optional overrides
DEEPSEEK_MODEL=deepseek-chat
OPENAI_ANALYSIS_MODEL=gpt-4o-mini
USE_LOCAL_WHISPER=             # set to 1 to use local mlx-whisper instead of OpenAI API (Apple Silicon)
MLX_WHISPER_MODEL=mlx-community/whisper-large-v3-mlx
EPISODES_DIR=episodes

# Download proxy (optional — for routing YouTube downloads via a remote server)
VPS_DOWNLOAD_URL=http://YOUR_SERVER_IP:8765
VPS_DOWNLOAD_TOKEN=

# ── Database (Phase 1+) ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/japanese_pipeline

# Flask session signing — set to a long random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── Object storage / Cloudflare R2 (Phase 4+) ────────────────────────────────
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=japanese-pipeline

# ── HTTP proxy (for bypassing regional API blocks) ────────────────────────────
HTTPS_PROXY=http://PROXY_HOST:PORT
NO_PROXY=.googlevideo.com,.ytimg.com,.youtube.com,.r2.cloudflarestorage.com
