OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...

# Optional overrides
GEMINI_MODEL=gemini-2.5-flash
OPENAI_ANALYSIS_MODEL=gpt-4o-mini
USE_LOCAL_WHISPER=             # set to 1 to use local mlx-whisper instead of OpenAI API (Apple Silicon)
MLX_WHISPER_MODEL=mlx-community/whisper-large-v3-mlx
EPISODES_DIR=episodes

# Download proxy (optional — for routing YouTube downloads via a remote server)
VPS_DOWNLOAD_URL=http://YOUR_SERVER_IP:8765
VPS_DOWNLOAD_TOKEN=
